<h1>Tasks:</h1>

<ul>
  <% @tasks.each do |task| %>
    <li>
      <%= form_for task do |f|%>
        <%= f.check_box :completed, class: 'task-toggle'  %>
      <% end %>
      <%= task.name %>
      <%= button_to "×", task, method: :delete,
        class: "delete-btn",
        "aria-label" => "Delete task",
        data: { confirm: "Delete this task?" } %>
    </li>
  <% end %> 
</ul>

<%= link_to "+ Add task", new_task_path %>
