<h1>Tasks:</h1>

<table>
  <% @tasks.each do |task| %>
    <tr>
      <td>
        <%= form_for task do |f|%>
          <%= f.check_box :completed %>
          <%= f.submit %>
        <% end %>
      </td>
      <td><%= task.name %></td> 
      <td> <%= button_to "Delete", task, method: :delete %> </td>
    </tr>
  <% end %> 
</table>

<%= link_to "+ Add task", new_task_path %>
